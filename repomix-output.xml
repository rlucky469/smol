  const year = String(new Date().getFullYear());
  const yearList = list.filter((i) => i.date.startsWith(year));
  return {
    year,
    totalSpent: yearList.filter((i) => i.status === 'Paid').reduce((sum, i) => sum + i.amount, 0),
    count: yearList.length,
  };
});

