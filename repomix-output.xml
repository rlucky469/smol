@use "variables" as *;
@use "font" as *;

body {
    overflow-x: hidden;
    background-color: var(--bgClr);
    #main {
        zoom: var(--zoom);
        @include animation("filter", var(--filter));
        position: relative;
    }
}

body.highlight-hover #main *:hover {
    outline-style: solid !important;
    outline-color: #639af9 !important;
    outline-width: 2px !important;
    outline-offset: 2px !important;
}

body.highlight-focus #main *:focus {
    outline-style: solid !important;
    outline-color: #639af9 !important;
    outline-width: 2px !important;
    outline-offset: 2px !important;
}

body.hide-images #main * {
    background-image: none !important;
}
body.hide-images #main * img {
    visibility: hidden;
}

body.big-black-cursor * {
    cursor: url("./assets/accessibility-icon/black-cursor.svg"), default !important;
}
body.big-black-cursor * input,
body.big-black-cursor * textarea,
body.big-black-cursor * select,
body.big-black-cursor * a,
body.big-black-cursor * button,
body.big-black-cursor * [role="button"] {
    cursor: url("./assets/accessibility-icon/black-pointer.svg"), default !important;
}

body.big-white-cursor * {
    cursor: url("./assets/accessibility-icon/white-cursor.svg"), default !important;
}
body.big-white-cursor * input,
body.big-white-cursor * textarea,
body.big-white-cursor * select,
body.big-white-cursor * a,
body.big-white-cursor * button,
body.big-white-cursor * [role="button"] {
    cursor: url("./assets/accessibility-icon/white-pointer.svg"), default !important;
}

body .reading-guide {
    display: block;
    position: fixed;
    top: 0;
    left: auto;
    right: auto;
    margin: auto;
    width: 500px;
    max-width: 90%;
    height: 12px;
    border-radius: 10px;
    pointer-events: none;
    background-color: #0274e6;
    border: solid 2px #000000;
    z-index: 999999;
}

body.stop-animations * {
    @include animation(transition, none !important);
    @include animation(animation-fill-mode, forwards !important);
    @include animation(animation-iteration-count, 1 !important);
    @include animation(animation-duration, 0.01s !important);
}

body.readable-font #main *:not(i) {
    font-family: Arial, Helvetica, sans-serif !important ;
}

body.dyslexia-font #main *:not(i) {
    font-family: "OpenDyslexic", serif !important;
}

.reading-mask-top {
    top: 0;
    bottom: auto;
}

.reading-mask-top {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    margin: auto;
    width: 100%;
    height: 0;
    pointer-events: none;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 100000000000000000000;
}

.reading-mask-bottom {
    top: auto;
    bottom: 0;
}

.reading-mask-bottom {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    margin: auto;
    width: 100%;
    pointer-events: none;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 100000000000000000000;
}

.text-to-speech {
    display: none;
    background: #0095c0;
    border-radius: 50%;
    position: absolute;
    z-index: 99999;
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.25);

    height: 50px;
    width: 50px;
    text-align: center;
    line-height: 50px;
    color: white;
    font-size: 20px;
    transition: 0.4s ease;
    .bottom-shape {
        width: 0;
        height: 0;
        position: absolute;
        border-left: 8px solid transparent;
        border-right: 8px solid transparent;
        border-top: 7px solid #0095c0;
        bottom: -5px;
    }
    &:hover {
        -webkit-transform: scale(1.08);
        transform: scale(1.08);
    }
}

.text-magnifie-tooltip {
    position: fixed;
    padding: 16px;
    border-radius: 4px;
    min-width: 200px;
    max-width: 800px;
    margin-right: 16px;
    background: #333;
    color: #fff;
    font-size: 36px;
    line-height: 1.5;
    z-index: 999999;
    background-color: #333333 !important;
    color: #ffffff !important;
    font-size: 36px !important;
}

.noselect {
    -webkit-touch-callout: none; /* iOS Safari */
    -webkit-user-select: none; /* Safari */
    -khtml-user-select: none; /* Konqueror HTML */
    -moz-user-select: none; /* Old versions of Firefox */
    -ms-user-select: none; /* Internet Explorer/Edge */
    user-select: none; /* Non-prefixed version, currently
                                    supported by Chrome, Edge, Opera and Firefox */
}

