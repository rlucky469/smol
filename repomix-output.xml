  &:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  &--low i {
    color: #ffc021;
  }

  &--empty i {
    color: #ffb3b3;
  }
}

.credit-dot {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ffc021;
  border: 1px solid var(--bgPrimaryText);
}

.credit-pill--empty .credit-dot {
  background: var(--dangerClr);
}

.credit-panel {
  width: 290px;
  padding: 16px;
  border: 1px solid #eceef5;
  border-radius: 12px;
