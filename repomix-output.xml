<file path="src/app/store/wallet/wallet.utils.ts">
import { ChargeRequest, SearchType, UsageInfo } from './wallet.model';

// Reads token usage from any AI response shape (usage object or flat fields)
export function extractUsage(source: any): UsageInfo {
  const u = source?.usage ?? source ?? {};
  return {
    model: String(u.model ?? u.modelName ?? u.model_name ?? ''),
    inputTokens: Number(u.inputTokens ?? u.input_tokens ?? u.prompt_tokens ?? 0) || 0,
    outputTokens: Number(u.outputTokens ?? u.output_tokens ?? u.completion_tokens ?? 0) || 0,
    cacheTokens: Number(u.cacheTokens ?? u.cache_tokens ?? u.cached_tokens ?? u.cacheReadTokens ?? 0) || 0,
  };
}

export function buildChargeRequest(
  searchType: SearchType,
  prompt: string,
  usageSource: any,
  requestKey?: string
): ChargeRequest {
  return {
    searchType,
    prompt: (prompt ?? '').slice(0, 1000),
    requestKey: requestKey || crypto.randomUUID(),
    ...extractUsage(usageSource),
  };
}
