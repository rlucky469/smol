<file path="src/app/components/active-profile/active-profile.html">
<div class="active-profile-card">

  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h6 class="fw-bold mb-0 text-uppercase active-profile-title">Active Profile</h6>
    <button
      type="button"
      class="btn btn-sm active-profile-edit-btn"
      (click)="onEdit()"
      [ngbTooltip]="isEditing() ? 'Cancel' : 'Edit'"
      placement="top"
    >
      <i class="far fa-edit"></i>
    </button>
  </div>

  <hr class="active-profile-divider" />

  @if (isEditing()) {
    <input
      type="text"
      class="form-control mb-2 active-profile-edit-input"
      placeholder="Organization name"
      [ngModel]="editName()"
      (ngModelChange)="editName.set($event)"
    />
    <textarea
      class="form-control active-profile-edit-textarea"
      rows="2"
      style="height: 80px !important;"
      placeholder="Short description"
      [ngModel]="editDescription()"
      (ngModelChange)="editDescription.set($event)"
    ></textarea>
  } @else {
    <h5 class="fw-bold mb-2">{{ profile.name }}</h5>
    <p class="text-muted small mb-0">{{ profile.description }}</p>
  }

  <hr class="active-profile-divider" />

  <!-- Geographic Focus -->
  <button type="button" class="active-profile-section-toggle" (click)="showGeographic.set(!showGeographic())">
    <span>Geographic Focus</span>
    <i class="fa" [class.fa-chevron-up]="showGeographic()" [class.fa-chevron-down]="!showGeographic()"></i>
  </button>

  @if (selectedCountries().length) {
    <div class="active-profile-chips mt-2">
      @for (country of selectedCountries(); track country.id) {
        <span class="active-profile-chip">
          {{ country.name }}
          <i class="fa fa-times" (click)="toggleCountry(country.id)"></i>
        </span>
      }
    </div>
  }

  @if (showGeographic()) {
    <div class="mt-3">
      <div class="active-profile-search mb-3">
        <i class="fa fa-search text-muted"></i>
        <input type="text" class="form-control border-0" placeholder="Search locations..." [(ngModel)]="countrySearch" />
      </div>

      <div class="active-profile-scroll">
        @for (country of visibleCountries(); track country.id) {
          <div class="form-check active-profile-checkbox mb-2">
            <input
              class="form-check-input"
              type="checkbox"
              [id]="'country-' + country.id"
              [checked]="selectedCountryIds().includes(country.id)"
              (change)="toggleCountry(country.id)"
            />
            <label class="form-check-label" [for]="'country-' + country.id">{{ country.name }}</label>
          </div>
        }
      </div>
    </div>
  }

  <hr class="active-profile-divider" />

  <!-- Impact Areas -->
  <button type="button" class="active-profile-section-toggle" (click)="showImpact.set(!showImpact())">
    <span>Impact Areas</span>
    <i class="fa" [class.fa-chevron-up]="showImpact()" [class.fa-chevron-down]="!showImpact()"></i>
  </button>

  @if (selectedIssues().length) {
    <div class="active-profile-chips mt-2">
      @for (issue of selectedIssues(); track issue.id) {
        <span class="active-profile-chip">
          {{ issue.name }}
          <i class="fa fa-times" (click)="toggleIssue(issue.id)"></i>
        </span>
      }
    </div>
  }

  @if (showImpact()) {
    <div class="mt-3">
      <div class="active-profile-search mb-3">
        <i class="fa fa-search text-muted"></i>
        <input type="text" class="form-control border-0" placeholder="Search areas..." [(ngModel)]="issueSearch" />
      </div>

      <div class="active-profile-scroll">
        @for (issue of visibleIssues(); track issue.id) {
          <div class="form-check active-profile-checkbox mb-2">
            <input
              class="form-check-input"
              type="checkbox"
              [id]="'issue-' + issue.id"
              [checked]="selectedIssueIds().includes(issue.id)"
              (change)="toggleIssue(issue.id)"
            />
            <label class="form-check-label" [for]="'issue-' + issue.id">{{ issue.name }}</label>
          </div>
        }
      </div>
    </div>
  }

  @if (hasChanges()) {
    <button type="button" class="btn active-profile-save-btn w-100 mt-4 text-center rounded-3" (click)="onSaveProfile()">
      Save & Update
    </button>
  }

</div>
