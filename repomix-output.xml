<ng-template #stepper let-title="title" let-icon="icon" let-key="key">
  <div class="feature-box">
    <div class="box-title">
      <h6><i [class]="icon"></i> {{ title }}</h6>
    </div>
    <div class="box-content">
      <div class="input-group">
        <span class="input-group-btn">
          <button (click)="key === 'contentScaling' ? themeService.contentScaling('inc') : key === 'fontSize' ? themeService.fontSizing('inc') : key === 'lineHeight' ? themeService.lineHeight('inc') : themeService.ltrSpacing('inc')"
            type="button" class="btn btn-default btn-number left">
            <i class="fas fa-angle-up"></i>
          </button>
        </span>
        <input type="text" class="form-control input-number" [value]="stepLabel(key)" disabled>
        <span class="input-group-btn">
          <button (click)="key === 'contentScaling' ? themeService.contentScaling('dec') : key === 'fontSize' ? themeService.fontSizing('dec') : key === 'lineHeight' ? themeService.lineHeight('dec') : themeService.ltrSpacing('dec')"
            type="button" class="btn btn-default btn-number right">
            <i class="fas fa-angle-down"></i>
          </button>
        </span>
      </div>
    </div>
  </div>
</ng-template>

<!-- Color picker box -->
<ng-template #colorPicker let-title="title" let-cat="cat" let-key="key" let-selected="selected">
