.action-btn {
  background: none;
  border: none;
  color: var(--textClr, #6b7280);
  opacity: 0.45;
  cursor: pointer;
  padding: 4px 6px;
  border-radius: 6px;
  line-height: 1;
  transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;

  &:hover:not(:disabled) {
    opacity: 1;
    background: rgba(0, 0, 0, 0.05);
  }

  &:disabled {
    cursor: default;
  }

  &.active-up {
    opacity: 1;
    color: #16a34a;
  }

  &.active-down {
    opacity: 1;
    color: #dc2626;
  }

  &.text-danger {
    &:hover { opacity: 1; }
  }
}

.msg-actions {
  opacity: 0;
  transition: opacity 0.2s ease;
}

.message:hover .msg-actions,
.message-out:hover .msg-actions {
  opacity: 1;
}


.rename-input {
  max-width: 220px;
  font-size: var(--bodyFont, 14px);
}


.chat-header {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
