                ul, ol { margin: 0.5rem 0 1rem 1.5rem; padding: 0; }
                li     { margin-bottom: 0.5rem; }

                strong { font-weight: 600; }
                em     { font-style: italic; }

                code {
                  background-color: #f1f1f1;
                  padding: 2px 6px;
                  border-radius: 4px;
                  font-family: monospace;
