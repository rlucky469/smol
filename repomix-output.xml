    position: relative;
    flex: 1;
    min-width: 0;
    background: var(--highLightBox);

    .chat-body {
      .chat-body-inner {
        padding-bottom: 87px;
        padding-top: 50px; // space for .chat-header

        .message-out {
          flex-direction: row-reverse;
          align-items: flex-end !important;

          .message-inner {
            margin-right: 1rem;
            max-width: 45% !important;

            .message-content {
              flex-direction: row-reverse;

