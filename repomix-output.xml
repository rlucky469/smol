//paragraph
@mixin paragraph(
  $value: null,
  $color: null,
  $lineHeight: null,
  $font: null,
  $align: null,
  $fontWeight: null,
  $ltrSpacing: 0,
  $outLine: null
) {
  font-size: $value;
  color: $color;
  line-height: $lineHeight;
  font-family: $font;
  text-align: $align;
  font-weight: $fontWeight;
  letter-spacing: $ltrSpacing;
  outline: $outLine;
}

//spacing
@mixin spacing($padding: null, $margin: null) {
  padding: $padding;
  margin: $margin;
}

//text clamp
@mixin textClamp($value, $height: auto) {
  display: -webkit-box;
  max-width: 100%;
  -webkit-line-clamp: $value;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: $height;
}

//border
@mixin border($value) {
  border-radius: $value;
  -webkit-border-radius: $value;
  -moz-border-radius: $value;
  -ms-border-radius: $value;
  -o-border-radius: $value;
}

//box-size
@mixin box($width: null, $height: null) {
  width: $width;
  height: $height;
}

@mixin bgShadow($bg, $shadow) {
  background: $bg;
  box-shadow: $shadow;
}

//position
@mixin position($position, $top: null, $right: null, $bottom: null, $left: null) {
  position: $position;
  top: $top;
  right: $right;
  bottom: $bottom;
  left: $left;
}

//animation
$prefixes: "webkit", "moz", "ms", "o", "none";
@mixin animation($property, $arguments) {
  @each $prefix in $prefixes {
    @if $prefix == "none" {
      #{$property}: $arguments;
    } @else {
      -#{$prefix}-#{$property}: $arguments;
    }
  }
}
