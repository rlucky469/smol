                border-radius: 0.6rem;
                padding: 1rem 1.25rem !important;
                overflow: hidden;
                margin-left: 0.25rem;
                margin-right: 0;
                background: var(--bgClr);
                font-size: var(--detailFont);
                color: var(--textClr);
                line-height: 26px;
              }
            }
          }
        }

        .message {
          display: flex;
          align-items: flex-start;
          margin-bottom: 40px;
          margin-right: 20px;
          .message-inner {
            margin-right: 1rem;
            margin-left: 1rem;

            .message-content {
              display: flex;
              align-items: center;

              .message-text {
                padding: 0;
                overflow: hidden;
                margin-left: 0.25rem;
                margin-right: 0;
                font-size: var(--detailFont);
                color: var(--textClr);
                line-height: 26px;

                h1 {
                  color: var(--textClr);
                  font-size: 20px;
                  line-height: 28px;
                  font-family: var(--fontFamily);
                  font-weight: 600;
                  letter-spacing: var(--letterSpacing);
                  margin-bottom: 14px;
                }

