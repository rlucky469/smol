        max-height: 420px;
        overflow-x: hidden;
        a {
            text-decoration: none;
        }
        .list-group-item {
            display: -webkit-box;
            max-width: 100%;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            height: 44px;
            padding: 14px 0;
            margin: 0;
            border-bottom: 1px solid #f4f5f9;
            border-left: none;
            border-right: none;
            background-color: var(--white);
            @include paragraph(
                var(--bodyFont),
                var(--textClr),
                var(--lineHeight),
                var(--fontFamily),
                var(--textLeft),
                normal,
                //font - weight
                var(--letterSpacing),
                var(--highLightLink)
            );
            outline-offset: 2px;
            span {
                @include paragraph(
                    var(--smallFont),
                    var(--textClr),
                    var(--lineHeight),
                    var(--fontFamily),
                    var(--textLeft),
                    600,
                    //font - weight
                    var(--letterSpacing),
                    var(--highLightLink)
                );
                @include border(8px);
                @include spacing(5px 10px, 0 8px 0 0);
                background: var(--bgClr);

            }
            &:hover{
                color: var(--hoverClr);
            }
        }
    }
}

@media only screen and (max-width: 1199px) {
    header {
        .navbar-expand-xl {
            .navbar-collapse {
                @include position(absolute, 100%, $left: 2%);
                @include bgShadow(var(--highLightBox), var(--shadow));
                width: 96%;
                z-index: 999;
                .nav-link {
                    @include spacing(12px);

                    border-bottom: 1px solid var(--bgClr);
