  font-family: var(--fontFamily);
  color: var(--textClr);
}

.credit-panel-label {
  font-size: var(--smallFont);
  font-weight: 600;
}

.credit-panel-value {
  font-size: var(--bodyFont);
  font-weight: 700;
  color: var(--primaryClr);
}

.credit-meter {
  height: 6px;
  border-radius: 999px;
  background: #e4e7f2;
  margin: 12px 0 8px;
  overflow: hidden;

  span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--primaryClr);
    transition: width 0.3s ease;
  }

  &--low span {
    background: #f39c12;
  }

  &--empty span {
    background: var(--dangerClr);
  }
}

.credit-panel-meta {
  font-size: 11px;
  opacity: 0.65;
  margin-bottom: 14px;
}

.credit-btn {
  display: block;
  text-align: center;
  font-size: var(--smallFont);
  font-weight: 600;
  padding: 9px;
