    <div class="box-title">
      <h6>{{ title }}</h6>
    </div>
    <div class="box-content">
      <div class="color-box">
        @for (color of colors; track color) {
        <span (click)="themeService.changeColor(cat, key, color)" [class]="'color ' + colorClass(color, selected)"
          [style.background-color]="color" [attr.aria-label]="'Change color to ' + color"></span>
