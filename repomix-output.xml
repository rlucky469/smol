@media (width < 768px) {
  .main-container {
    height: 100vh;
    .main { height: 100vh; }
    .side-bar { display: none; }
    .side-bar.visibleSidebar {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 80%;
      min-width: 0;
      z-index: 99;
      box-shadow: 0 10px 30px rgba(20, 24, 40, 0.2);
    }
  }
}

@media (width >= 768px) {
  .main-container .side-bar { display: block; }
}

@media (width <= 576px) {
  .main-container .main .chat-footer .chat-box { margin: 0 20px; }
}


.typing-indicator {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 8px 4px;

  span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--primaryClr, #4f46e5);
    opacity: 0.4;
    animation: typingBounce 1.2s infinite ease-in-out;

    &:nth-child(1) { animation-delay: 0s; }
    &:nth-child(2) { animation-delay: 0.2s; }
    &:nth-child(3) { animation-delay: 0.4s; }
  }
}

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: scale(0.8);
    opacity: 0.4;
  }
  40% {
    transform: scale(1.2);
    opacity: 1;
  }
}
